<Window x:Class="Nitrous.Ui.NitrousDashboard"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nitrous Dashboard" Height="660" Width="375"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        IsVisibleChanged="Window_IsVisibleChanged"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Deactivated="Window_Deactivated">
	<Window.Resources>
		<BitmapImage x:Key="CachedAppLogo" UriSource="pack://application:,,,/assets/logo.png" CacheOption="OnLoad" />
		<Style x:Key="ActionButtonStyle" TargetType="RadioButton">
			<!-- Default state: Transparent background to blend into the rail -->
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="TabIndex" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Grid Background="Transparent">
							<Border x:Name="LeftDivider"
                                    Width="1"
                                    Height="16"
                                    Background="{DynamicResource BorderSubtleBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
							<!-- Main Floating Pill -->
							<Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Margin="0"
                                    SnapsToDevicePixels="True">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        Fill="{TemplateBinding Foreground}"
                                        Stretch="Uniform"
                                        Width="14" Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"/>
									<TextBlock Text="{TemplateBinding Content}"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"/>
								</StackPanel>
							</Border>
						</Grid>
						<ControlTemplate.Triggers>
							<!-- Hide the divider if this is the very first item in the track -->
							<Trigger Property="TabIndex" Value="0">
								<Setter TargetName="LeftDivider" Property="Visibility" Value="Collapsed"/>
							</Trigger>
							<!-- Hover State -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
								<Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}"/>
								<Setter TargetName="LeftDivider" Property="Opacity" Value="0"/>
								<!-- Expanding by 1px horizontally seamlessly masks adjacent dividers -->
								<Setter TargetName="MainBorder" Property="Margin" Value="-1,0,-1,0"/>
								<Setter Property="Panel.ZIndex" Value="1"/>
							</Trigger>
							<!-- Checked State -->
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource AccentWashBrush}"/>
								<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
								<Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
								<Setter TargetName="LeftDivider" Property="Opacity" Value="0"/>
								<!-- Expanding by 1px horizontally seamlessly masks adjacent dividers -->
								<Setter TargetName="MainBorder" Property="Margin" Value="-1,0,-1,0"/>
								<!-- Elevating Z-Index ensures the active pill draws OVER the dividers of its neighbors -->
								<Setter Property="Panel.ZIndex" Value="2"/>
							</Trigger>
							<!-- Disabled State -->
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.3"/>
								<Setter Property="Cursor" Value="Arrow"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Modern iOS-style Toggle -->
		<Style x:Key="ModernToggleStyle" TargetType="CheckBox">
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<Border x:Name="BgBorder" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource ToggleTrackBrush}">
							<Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
								<Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
								<Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
								<Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource WindowBgBrush}"/>
							</Trigger>
							<!-- A disabled toggle used to look exactly like an enabled one, so a control the
							     model does not support invited a click that could never do anything. -->
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.35"/>
								<Setter Property="Cursor" Value="Arrow"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Modern Slider -->
		<Style x:Key="ModernSliderStyle" TargetType="Slider">
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="SmallChange" Value="1"/>
			<Setter Property="LargeChange" Value="10"/>
			<Setter Property="IsMoveToPointEnabled" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Slider">
						<Grid Height="20">
							<Border Height="4" Background="{DynamicResource BorderSubtleBrush}" CornerRadius="2" VerticalAlignment="Center"/>
							<Track x:Name="PART_Track">
								<Track.DecreaseRepeatButton>
									<RepeatButton Command="Slider.DecreaseLarge">
										<RepeatButton.Template>
											<ControlTemplate TargetType="RepeatButton">
												<Border Height="4" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="2"/>
											</ControlTemplate>
										</RepeatButton.Template>
									</RepeatButton>
								</Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb>
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Ellipse Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" StrokeThickness="1" Cursor="Hand"/>
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>
								</Track.Thumb>
								<Track.IncreaseRepeatButton>
									<RepeatButton Command="Slider.IncreaseLarge">
										<RepeatButton.Template>
											<ControlTemplate TargetType="RepeatButton">
												<Border Background="Transparent"/>
											</ControlTemplate>
										</RepeatButton.Template>
									</RepeatButton>
								</Track.IncreaseRepeatButton>
							</Track>
						</Grid>

						<ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Custom Fan Toggle -->
		<Style x:Key="SquareCheckBoxStyle" TargetType="CheckBox">
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal">
							<Border Width="12" Height="12" Background="{DynamicResource TextPrimaryBrush}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0">
								<Path x:Name="CheckIcon" Data="M3,8L6,11L11,3" Stroke="{DynamicResource WindowBgBrush}" StrokeThickness="2" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
							</Border>
							<TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Bottom Nav Button -->
		<Style x:Key="NavButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="{DynamicResource RailHoverBrush}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- A swatch that opens a colour picker. Keeps its colour on hover so it still reads as a
		     colour rather than as a button. -->
		<Style x:Key="ColorChipStyle" TargetType="Button">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Chip" Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6" Padding="8,3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.4"/>
								<Setter Property="Cursor" Value="Arrow"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />

		<Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinHeight" Value="58"/>
        </Style>

        <Style x:Key="SetupSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,4,0,6"/>
        </Style>

        <Style x:Key="SetupActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <Style x:Key="CompactComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentWashBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <Grid Margin="8,0,7,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  IsHitTestVisible="False"/>
                                <Path Grid.Column="1" Data="M7,10L12,15L17,10H7Z" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" Width="8" Height="6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0"
                                        Width="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource WindowBgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="{DynamicResource TextPrimaryBrush}" Opacity="0" CornerRadius="8"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotkeyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentDeepBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="0">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}"/>
                            </Trigger>
                            <!-- Clicked / Active effect -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin, quiet scrollbar used by long settings pages. -->
        <Style x:Key="SlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Margin="0,3">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" Background="{DynamicResource DividerBrush}" CornerRadius="2" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.35"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ZoneSwatchStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Border Background="{DynamicResource ScrimBrush}" CornerRadius="4" Padding="7,2" Margin="6" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

		<!-- A swatch is a colour chip, so the button chrome is stripped and the content is the ring. -->
		<Style x:Key="AccentSwatchStyle" TargetType="Button">
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<ContentPresenter/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<!-- Outer Frame with Rounded Corners -->
	<Border Background="{DynamicResource WindowBgBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="50"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="54"/>
			</Grid.RowDefinitions>
			<!-- Title Bar -->
			<Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
				<TextBlock x:Name="SystemModelText" Text="NITROUS ON SYSTEM" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center"/>
				<!-- Right Side: Power Pill, Pin to Top & Close -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
					<!-- 1. Dynamic Power State Pill -->
                    <Border x:Name="DashPowerPillBorder" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0"
                            ToolTip="Measured battery charge/discharge rate. Windows does not expose the adapter's rated wattage.">
                        <Grid>
                            <!-- Auto-tinting subtle background -->
                            <Border Background="{Binding BorderBrush, ElementName=DashPowerPillBorder}" Opacity="0.15" CornerRadius="5"/>

                            <StackPanel Orientation="Horizontal" Margin="8,4">
                                <!-- Updated to an AC Power Plug icon -->
                                <Path x:Name="DashPowerPillIcon" Fill="{DynamicResource DangerBrush}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0" Data="M16,7V3H14V7H10V3H8V7C8,10 9.79,11.4 11,11.83V16H13V11.83C14.21,11.4 16,10 16,7M10,18H14V22H10V18Z"/>
                                <TextBlock x:Name="DashPowerPillText" Text="AC POWER" Foreground="{DynamicResource DangerBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PowerPillWattsText}"
                                           Foreground="{Binding Foreground, ElementName=DashPowerPillText}"
                                           FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
					<!-- 2. Pin to Top Toggle -->
					<ToggleButton x:Name="BtnPinTop"
                                Cursor="Hand"
                                Margin="0,0,12,0"
                                ToolTip="Pin to Top"
                                IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
						<ToggleButton.Template>
							<ControlTemplate TargetType="ToggleButton">
								<Grid Background="Transparent">
									<Path x:Name="PinIcon"
                                        Fill="{DynamicResource TextMutedBrush}"
                                        Stretch="Uniform"
                                        Width="13"
                                        Height="13"
                                        Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                                        VerticalAlignment="Center"/>
								</Grid>
								<ControlTemplate.Triggers>
									<!-- Hover state: Brightens up like the close button -->
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="PinIcon" Property="Fill" Value="{DynamicResource TextStrongBrush}"/>
									</Trigger>
									<!-- Checked state: Lights up with your purple accent color -->
									<Trigger Property="IsChecked" Value="True">
										<Setter TargetName="PinIcon" Property="Fill" Value="{DynamicResource AccentBrush}"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</ToggleButton.Template>
					</ToggleButton>
					<!-- 3. Close Button -->
					<Button Content="✕" Foreground="{DynamicResource TextMutedBrush}" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="CloseBtn_Click" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
				<Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderSubtleBrush}"/>
			</Grid>
			<!-- PAGES -->
			<Grid Grid.Row="1">
				<!-- 1. DASHBOARD PAGE -->
				<ScrollViewer x:Name="DashPage" Visibility="Visible" Margin="20,10,20,0"
				              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
				              BorderThickness="0" FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly">
					<ScrollViewer.Resources>
						<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBarStyle}"/>
					</ScrollViewer.Resources>
					<StackPanel Margin="0,0,4,16">
					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Margin="0,0,0,12" Padding="12">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,12,0">
								<Image Source="{StaticResource CachedAppLogo}" RenderOptions.BitmapScalingMode="HighQuality" Margin="8" Stretch="Uniform"/>
							</Border>
							<StackPanel VerticalAlignment="Center">
								<TextBlock x:Name="DashVersionText" Text="Nitrous" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14"/>
								<TextBlock Text="Pure hardware control for Acer Nitro laptops." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
							</StackPanel>
						</StackPanel>
					</Border>
					<!-- LIVE TELEMETRY WIDGET -->
					<Grid Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<!-- CPU Telemetry -->
						<Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
								<!-- Inline Fan RPM -->
								<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0">
									<Path Fill="{DynamicResource AccentBrush}" Opacity="0.8" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" Data="M9,2V4H15V2H17V4H19A2,2 0 0,1 21,6V8H23V10H21V16H23V18H21V20A2,2 0 0,1 19,22H17V24H15V22H9V24H7V22H5A2,2 0 0,1 3,20V18H1V16H3V10H1V8H3V6A2,2 0 0,1 5,4H7V2H9M5,6V20H19V6H5M7,8H17V18H7V8M9,10H15V16H9V10Z"/>
									<TextBlock Text="{Binding CpuRpmText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
								</StackPanel>
								<!-- Temperature on the Right -->
								<TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding CpuTempText}" Foreground="{Binding CpuTempColor}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
							</Grid>
						</Border>
						<!-- GPU Telemetry -->
						<Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0" Grid.Column="0" Text="GPU" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
								<!-- Inline Fan RPM -->
								<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0">
									<Path Fill="{DynamicResource AccentBrush}" Opacity="0.8" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" Data="M22,9V7H20V5A2,2 0 0,0 18,3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H18A2,2 0 0,0 20,19V17H22V15H20V13H22V11H20V9H22M18,19H4V5H18V19M6,13H11V17H6V13M12,7H16V10H12V7M6,7H11V12H6V7M12,11H16V17H12V11Z"/>
									<TextBlock Text="{Binding GpuRpmText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
								</StackPanel>
								<!-- Temperature on the Right -->
								<TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding GpuTempText}" Foreground="{Binding GpuTempColor}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
							</Grid>
						</Border>
					</Grid>
					<!-- Power Modes -->
					<Grid Margin="0,0,0,8">
						<TextBlock Text="POWER" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
						<!-- Shown only when Nitrous has actually asked the driver for WhisperMode, so it can
						     never claim a state the driver refused. -->
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Nitrous asked the NVIDIA driver for Whisper Mode in Quiet. The NVIDIA App shows its own setting."
						            Visibility="{Binding WhisperModeActive, Converter={StaticResource BoolToVis}}">
							<TextBlock Text="Whisper Mode:" Foreground="{DynamicResource TextDimBrush}" FontSize="10" VerticalAlignment="Center"/>
							<TextBlock Text="On" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
						</StackPanel>
					</Grid>
					<Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,16">
						<UniformGrid Rows="1" Height="34">
							<RadioButton x:Name="BtnPowerQuiet" TabIndex="0" GroupName="Power" Uid="Quiet" Tag="M1,13 L9.4,11.5 A3,3 0 1,1 9.4,14.5 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Quiet" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}" CommandParameter="Quiet"/>
							<RadioButton x:Name="BtnPowerBal" TabIndex="1" GroupName="Power" Uid="Balanced" Tag="M12,2 L13.5,10.4 A3,3 0 1,1 10.5,10.4 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Bal" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}" CommandParameter="Balanced"/>
							<RadioButton x:Name="BtnPowerPerf" TabIndex="1" GroupName="Power" Uid="Performance" Tag="M19.78,5.22 L14.9,12.22 A3,3 0 1,1 12.78,10.1 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Perf" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}" CommandParameter="Performance"/>
							<RadioButton x:Name="BtnPowerTurbo" TabIndex="1" GroupName="Power" Uid="Turbo" Tag="M19.78,20.78 L12.78,15.9 A3,3 0 1,1 14.9,13.78 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Turbo" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetPowerCommand}" CommandParameter="Turbo" Visibility="{Binding IsTurboSupported, Converter={StaticResource BoolToVis}}"/>
						</UniformGrid>
					</Border>
					<!-- Display: refresh rate and panel overdrive -->
					<Grid Margin="0,0,0,8">
						<TextBlock Text="DISPLAY" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock x:Name="DisplayCurrentText" Foreground="{DynamicResource TextDimBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
					</Grid>
					<Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
						<StackPanel>
							<!-- Refresh rate -->
							<Grid>
								<TextBlock Text="Refresh" Foreground="{DynamicResource TextBodyBrush}" FontSize="10.5" VerticalAlignment="Center"/>
								<ComboBox x:Name="RefreshModeBox" HorizontalContentAlignment="Center" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CompactComboBoxStyle}" SelectionChanged="RefreshMode_Changed"/>
							</Grid>

							<!-- Panel overdrive: the whole row is collapsed where the panel has none -->
							<Grid x:Name="LcdOverdriveRow" Margin="0,10,0,0">
								<TextBlock x:Name="LcdOverdriveLabel" Text="LCD Overdrive" Foreground="{DynamicResource TextBodyBrush}" FontSize="10.5" VerticalAlignment="Center"/>
								<CheckBox x:Name="TogLcdOverdrive" ToolTipService.ShowOnDisabled="True" Style="{StaticResource ModernToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="LcdOverdrive_Toggled" Unchecked="LcdOverdrive_Toggled"/>
							</Grid>
						</StackPanel>
					</Border>
					<!-- Fans -->
					<TextBlock Text="FANS" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
					<Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,16">
						<UniformGrid Rows="1" Height="34">
							<RadioButton x:Name="BtnFanAuto" TabIndex="0" GroupName="Fans" Uid="Auto" Tag="M12,4V1L7,5L12,9V6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6.34,14H4.27A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Content="Auto" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetFanCommand}" CommandParameter="Auto"/>
							<RadioButton x:Name="BtnFanMax" TabIndex="1" GroupName="Fans" Uid="Max" Tag="M19.78,20.78 L12.78,15.9 A3,3 0 1,1 14.9,13.78 Z M4.93,20.06 A10,10 0 1,1 19.07,20.06 C18.68,20.45 18.05,20.45 17.66,20.06 C17.27,19.67 17.27,19.04 17.66,18.65 A8,8 0 1,0 6.34,18.65 C6.74,19.04 6.74,19.67 6.35,20.06 C5.96,20.45 5.32,20.45 4.93,20.06 Z" Content="Max" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetFanCommand}" CommandParameter="Max"/>
							<RadioButton x:Name="BtnFanCustom" TabIndex="1" GroupName="Fans" Uid="Medium" Tag="M3,7V9H13V7H3M15,11H17V9H21V7H17V5H15V11ZM3,15V17H9V15H3M13,19V17H21V15H13V13H11V19H13Z" Content="Custom" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetFanCommand}" CommandParameter="Medium"/>
						</UniformGrid>
					</Border>
					<StackPanel x:Name="CustomFanSection" Opacity="{Binding CustomFanOpacity}">
						<Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="12,12,12,16">
							<StackPanel>
								<Grid Margin="0,0,0,12">
                                    <TextBlock Text="CUSTOM FAN SPEED" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Button to open Fan Curve Editor Window -->
                                        <Button Content="CURVE EDITOR"
                                                Click="OpenCurveEditor_Click"
                                                Style="{StaticResource GhostBtn}"
                                                FontSize="9"
                                                Padding="6,2"
                                                Margin="0,0,8,0"
                                                IsEnabled="{Binding IsCustomFanEnabled}"/>

                                        <CheckBox x:Name="TogUnifiedFans"
                                                Content="UNIFIED"
                                                Style="{StaticResource SquareCheckBoxStyle}"
                                                IsChecked="{Binding IsUnifiedFans, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsManualSliderEnabled}"/>
                                    </StackPanel>
                                </Grid>
								<!-- CPU Slider -->
								<Grid Margin="0,0,0,4">
									<TextBlock Text="CPU Fan Speed" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
										<TextBox x:Name="CpuFanInput" Text="{Binding CpuFanSpeed, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Background="Transparent" BorderThickness="0" MaxLength="3" Width="26" TextAlignment="Right" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" IsEnabled="{Binding IsManualSliderEnabled}"/>
										<TextBlock Text="%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
      										<TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManualSliderEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
										</TextBlock>
									</StackPanel>
								</Grid>
								<Slider x:Name="CpuFanSlider" Style="{StaticResource ModernSliderStyle}" Minimum="1" Maximum="100" Value="{Binding CpuFanSpeed, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsManualSliderEnabled}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,12"/>
								<!-- GPU Slider -->
								<Grid Margin="0,0,0,4">
									<TextBlock Text="GPU Fan Speed" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
										<TextBox x:Name="GpuFanInput" Text="{Binding GpuFanSpeed, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Background="Transparent" BorderThickness="0" MaxLength="3" Width="26" TextAlignment="Right" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" IsEnabled="{Binding IsManualSliderEnabled}"/>
										<TextBlock Text="%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
    										<TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManualSliderEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
										</TextBlock>
									</StackPanel>
								</Grid>
								<Slider x:Name="GpuFanSlider" Style="{StaticResource ModernSliderStyle}" Minimum="1" Maximum="100" Value="{Binding GpuFanSpeed, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsManualSliderEnabled}" IsSnapToTickEnabled="True" TickFrequency="1"/>
							</StackPanel>
						</Border>
					</StackPanel>
					</StackPanel>
				</ScrollViewer>
				<!-- 2. SETTINGS PAGE (Bound to Properties) -->
				<ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Margin="20,10,20,0"
				              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
				              BorderThickness="0" FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly">
					<ScrollViewer.Resources>
						<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBarStyle}"/>
					</ScrollViewer.Resources>
					<StackPanel Margin="0,0,4,10">
					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Margin="0,0,0,10" Padding="12">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,12,0">
								<Image Source="{StaticResource CachedAppLogo}" RenderOptions.BitmapScalingMode="HighQuality" Margin="8" Stretch="Uniform"/>
							</Border>
							<StackPanel VerticalAlignment="Center">
								<TextBlock x:Name="SettingsVersionText" Text="Nitrous" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14"/>
								<TextBlock Text="Pure hardware control for Acer Nitro laptops." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<TextBlock Text="POWER &amp; PERFORMANCE" Style="{StaticResource SetupSectionLabelStyle}" Margin="4,0,0,6"/>

					<!-- CPU power limits and processor boost -->
					<Border Style="{StaticResource SetupCardStyle}" Padding="12,10">
						<StackPanel>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
									<StackPanel Orientation="Horizontal" Margin="0,0,0,2">
										<Path Data="M7,4V6H5C3.89,6 3,6.89 3,8V10H1V12H3V14H1V16H3V18C3,19.1 3.89,20 5,20H7V22H9V20H11V22H13V20H15V22H17V20H19C20.1,20 21,19.1 21,18V16H23V14H21V12H23V10H21V8C21,6.89 20.1,6 19,6H17V4H15V6H13V4H11V6H9V4H7M5,8H19V18H5V8M7,10V16H17V10H7M9,12H15V14H9V12Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
										<TextBlock Text="CPU Power" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
									</StackPanel>
									<TextBlock Text="Adjust Windows CPU power limits and processor boost for the active profile." Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap"/>
								</StackPanel>
								<CheckBox Grid.Column="1" x:Name="TogManageCpu" Style="{StaticResource ModernToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ManageCpuPower, UpdateSourceTrigger=PropertyChanged}"/>
							</Grid>
							<Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,10,0,10"/>
							<TextBlock Text="PROCESSOR BOOST" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Plugged in" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
								<ComboBox Grid.Column="1" Width="190" HorizontalAlignment="Right"
								          Style="{StaticResource CompactComboBoxStyle}"
								          ItemsSource="{Binding BoostModes}" DisplayMemberPath="Name"
								          SelectedItem="{Binding BoostAcMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								          IsEnabled="{Binding IsBoostSupported}"
								          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
							</Grid>
							<Grid Margin="0,6,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="On battery" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
								<ComboBox Grid.Column="1" Width="190" HorizontalAlignment="Right"
								          Style="{StaticResource CompactComboBoxStyle}"
								          ItemsSource="{Binding BoostModes}" DisplayMemberPath="Name"
								          SelectedItem="{Binding BoostDcMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								          IsEnabled="{Binding IsBoostSupported}"
								          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
							</Grid>
							<Grid Margin="0,8,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="{Binding BoostStatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"
								           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
								<Button Grid.Column="1" Content="RESTORE" Command="{Binding RestoreBoostCommand}"
								        Style="{StaticResource SetupActionButtonStyle}"
								        ToolTip="Restore the boost values Windows had before Nitrous changed them."
								        IsEnabled="{Binding IsBoostSupported}"/>
							</Grid>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource SetupCardStyle}">
					    <Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
