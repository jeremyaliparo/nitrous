<Window x:Class="Nitrous.Ui.NitrousDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nitrous Dashboard" Height="670" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        IsVisibleChanged="Window_IsVisibleChanged"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Modern Action Button with Native SVG Path Data -->
        <Style x:Key="ActionButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#2A2A30" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Tag stores the raw SVG Geometry now -->
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#B388FF"/>
                                <Setter Property="Foreground" Value="#121214"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS-style Toggle -->
        <Style x:Key="ModernToggleStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BgBorder" Width="44" Height="24" CornerRadius="12" Background="#35353A">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#B388FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#121214"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider -->
<Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="#B388FF"/>
            <Setter Property="SmallChange" Value="1"/> <!-- Enables precise Arrow Key movement -->
            <Setter Property="LargeChange" Value="10"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/> <!-- Instantly jump to where you click -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Border Height="4" Background="#2A2A30" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- FIX: Tell the track to steal the Violet color from the main Slider! -->
                                                <Border Height="4" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- FIX: Tell the Thumb outline to steal the Violet color too -->
                                                <Ellipse Width="14" Height="14" Fill="White" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SquareCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#B388FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border Width="12" Height="12" Background="White" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path x:Name="CheckIcon" Data="M3,8L6,11L11,3" Stroke="#121214" StrokeThickness="2" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                            </Border>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom Nav Button (Fixes sharp hover corners by binding Tag to CornerRadius) -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#17171A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#121214" CornerRadius="16" BorderBrush="#2A2A30" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                <TextBlock x:Name="SystemModelText" Text="NITROUS ON SYSTEM" Foreground="White" FontSize="13" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <Button Content="✕" Foreground="#888890" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Click="CloseBtn_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border VerticalAlignment="Bottom" Height="1" Background="#2A2A30"/>
            </Grid>

<!-- PAGES -->
            <Grid Grid.Row="1">
                <!-- 1. DASHBOARD PAGE -->
                <StackPanel x:Name="DashPage" Visibility="Visible" Margin="20,10,20,0">
                    <Border Background="#1C1C1F" CornerRadius="12" Height="160" Margin="0,0,0,20">
                        <Grid>
                            <Border x:Name="DashPowerPillBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Background="#151518" BorderThickness="1" BorderBrush="#FF453A" CornerRadius="6" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="DashPowerPillIcon" Fill="#FF453A" Stretch="Uniform" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="DashPowerPillText" Text="AC POWER" Foreground="#FF453A" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <Border Width="64" Height="64" CornerRadius="14" Background="#26262A" Margin="0,0,0,12">
                                    <Image Source="pack://application:,,,/assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="8" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Name="DashVersionText" Text="Nitrous" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                                <TextBlock Text="Pure, zero-bloat hardware control for Acer Nitro laptops." TextWrapping="Wrap" Foreground="#888890" FontSize="11" TextAlignment="Center" Margin="10,0,10,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Power Modes (Bound via Command) -->
                    <TextBlock Text="POWER" Foreground="#888890" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid Height="40" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="BtnPowerQuiet" GroupName="Power" Uid="Quiet" Tag="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22L6.66 19.7C7.14 19.87 7.64 20 8 20C19 20 22 3 22 3C21 5 14 5.25 9 6.25C4 7.25 7 11.5 7 11.5C7 11.5 9 4 17 8Z" Content="Quiet" Style="{StaticResource ActionButtonStyle}" Grid.Column="0" Margin="0,0,4,0" Command="{Binding SetPowerCommand}" CommandParameter="Quiet"/>
                        <RadioButton x:Name="BtnPowerBal" GroupName="Power" Uid="Balanced" Tag="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,11.91L11,16.5Z" Content="Bal" Style="{StaticResource ActionButtonStyle}" Grid.Column="1" Margin="2,0,2,0" Command="{Binding SetPowerCommand}" CommandParameter="Balanced"/>
                        <RadioButton x:Name="BtnPowerPerf" GroupName="Power" Uid="Performance" Tag="M7,2V13H10V22L17,10H13L17,2H7Z" Content="Perf" Style="{StaticResource ActionButtonStyle}" Grid.Column="2" Margin="2,0,2,0" Command="{Binding SetPowerCommand}" CommandParameter="Performance"/>
                        <RadioButton x:Name="BtnPowerTurbo" GroupName="Power" Uid="Turbo" Tag="M14,2L12.6,3.4C11.6,4.4 10.9,5.7 10.6,7.1L9.6,12L4.5,13.7C3.5,14 2.8,14.8 2.5,15.8L2.2,16.8L6.8,15.2C7.3,15 7.8,15 8.3,15.1L12.5,16.4C12.4,16.7 12.3,17 12.1,17.2L10.7,18.6L12.1,20L15.6,16.5C16.8,15.3 17.5,13.8 17.8,12.1L18.7,6.8L22,5.7C23,5.4 23.7,4.6 24,3.6L24.3,2.6L19.7,4.2C19.2,4.4 18.7,4.4 18.2,4.3L14,3C14.1,2.7 14.2,2.4 14.4,2.2L15.8,0.8L14,2Z" Content="Turbo" Style="{StaticResource ActionButtonStyle}" Grid.Column="3" Margin="4,0,0,0" Command="{Binding SetPowerCommand}" CommandParameter="Turbo"/>
                    </Grid>

                    <!-- Fans (Bound via Command) -->
                    <TextBlock Text="FANS" Foreground="#888890" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid Height="40" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="BtnFanAuto" GroupName="Fans" Uid="Auto" Tag="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z" Content="Auto" Style="{StaticResource ActionButtonStyle}" Grid.Column="0" Margin="0,0,4,0" Command="{Binding SetFanCommand}" CommandParameter="Auto"/>
                        <RadioButton x:Name="BtnFanMax" GroupName="Fans" Uid="Max" Tag="M12,16A3,3 0 0,1 9,13C9,11.88 9.61,10.9 10.5,10.39L20.21,4.77L14.68,14.35C14.18,15.33 13.17,16 12,16M12,3C13.81,3 15.5,3.5 16.97,4.32L14.87,5.53C13.96,5.19 13,5 12,5A8,8 0 0,0 4,13C4,15.21 4.89,17.21 6.34,18.65H6.35C6.74,19.04 6.74,19.67 6.35,20.06C5.96,20.45 5.32,20.45 4.93,20.06C3.12,18.26 2,15.76 2,13A10,10 0 0,1 12,3M22,13C22,15.76 20.88,18.26 19.07,20.06C18.68,20.45 18.05,20.45 17.66,20.06C17.27,19.67 17.27,19.04 17.66,18.65C19.11,17.2 20,15.21 20,13C20,12 19.81,11.04 19.47,10.13L20.68,8.03C21.5,9.5 22,11.19 22,13Z" Content="Max" Style="{StaticResource ActionButtonStyle}" Grid.Column="1" Margin="2,0,2,0" Command="{Binding SetFanCommand}" CommandParameter="Max"/>
                        <RadioButton x:Name="BtnFanCustom" GroupName="Fans" Uid="Medium" Tag="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z" Content="Custom" Style="{StaticResource ActionButtonStyle}" Grid.Column="2" Margin="4,0,0,0" Command="{Binding SetFanCommand}" CommandParameter="Medium"/>
                    </Grid>

                    <StackPanel x:Name="CustomFanSection" Margin="0,5,0,0" Opacity="{Binding CustomFanOpacity}">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CUSTOM FAN SPEED" Foreground="#888890" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <CheckBox x:Name="TogUnifiedFans" Content="UNIFIED" Style="{StaticResource SquareCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding IsUnifiedFans, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomFanEnabled}"/>
                        </Grid>
                        <Border Background="#1C1C1F" CornerRadius="8" BorderBrush="#2A2A30" BorderThickness="1" Padding="15,15,15,10">
                            <StackPanel>
                                <!-- CPU Slider (Bound to Property) -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="CPU Fan Speed" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="CpuFanInput" Text="{Binding CpuFanSpeed, UpdateSourceTrigger=PropertyChanged}" Foreground="#B388FF" FontSize="11" FontWeight="Bold" Background="Transparent" BorderThickness="0" MaxLength="3" Width="26" TextAlignment="Right" VerticalContentAlignment="Center" CaretBrush="#B388FF" IsEnabled="{Binding IsCustomFanEnabled}"/>
                                        <TextBlock Text="%" Foreground="#B388FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="CpuFanSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100" Value="{Binding CpuFanSpeed, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomFanEnabled}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,15"/>

                                <!-- GPU Slider (Bound to Property) -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="GPU Fan Speed" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="GpuFanInput" Text="{Binding GpuFanSpeed, UpdateSourceTrigger=PropertyChanged}" Foreground="#B388FF" FontSize="11" FontWeight="Bold" Background="Transparent" BorderThickness="0" MaxLength="3" Width="26" TextAlignment="Right" VerticalContentAlignment="Center" CaretBrush="#B388FF" IsEnabled="{Binding IsCustomFanEnabled}"/>
                                        <TextBlock Text="%" Foreground="#B388FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="GpuFanSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100" Value="{Binding GpuFanSpeed, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomFanEnabled}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 2. SETTINGS PAGE (Bound to Properties) -->
                <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Margin="20,10,20,0">
                    <Border Background="#1C1C1F" CornerRadius="12" Height="160" Margin="0,0,0,20">
                        <Grid>
                            <Border x:Name="SettingsPowerPillBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Background="#151518" BorderThickness="1" BorderBrush="#FF453A" CornerRadius="6" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="SettingsPowerPillIcon" Fill="#FF453A" Stretch="Uniform" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="SettingsPowerPillText" Text="AC POWER" Foreground="#FF453A" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <Border Width="64" Height="64" CornerRadius="14" Background="#26262A" Margin="0,0,0,12">
                                    <Image Source="pack://application:,,,/assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="8" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Name="SettingsVersionText" Text="Nitrous" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                                <TextBlock Text="Pure, zero-bloat hardware control for Acer Nitro laptops." TextWrapping="Wrap" Foreground="#888890" FontSize="11" TextAlignment="Center" Margin="10,0,10,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="POWER &amp; PERFORMANCE RULES" Foreground="#888890" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Border Background="#1C1C1F" CornerRadius="10" Height="70" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Path Data="M16.67,4H15V2H9V4H7.33A1.33,1.33 0 0,0 6,5.33V20.67C6,21.4 6.6,22 7.33,22H16.67A1.33,1.33 0 0,0 18,20.67V5.33C18,4.6 17.4,4 16.67,4Z" Fill="White" Stretch="Uniform" Width="10" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="80% Battery Limit" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Extends battery lifespan by capping max charge." Foreground="#888890" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="TogCharge" Style="{StaticResource ModernToggleStyle}" HorizontalAlignment="Right" Margin="0,0,15,0" IsChecked="{Binding ChargeLimit, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Background="#1C1C1F" CornerRadius="10" Height="70" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Path Data="M16,7V3H14V7H10V3H8V7C8,10 9.79,11.4 11,11.83V16H13V11.83C14.21,11.4 16,10 16,7M10,18H14V22H10V18Z" Fill="White" Stretch="Uniform" Width="12" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Auto-Switch Power" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Adapts performance plan based on AC/DC state." Foreground="#888890" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="TogAutoSwitch" Style="{StaticResource ModernToggleStyle}" HorizontalAlignment="Right" Margin="0,0,15,0" IsChecked="{Binding AutoSwitch, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Background="#1C1C1F" CornerRadius="10" Height="70" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Path Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z" Fill="White" Stretch="Uniform" Width="14" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Auto-Switch Hz" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Lowers refresh rate to 60Hz when on battery." Foreground="#888890" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="TogRefreshSwitch" Style="{StaticResource ModernToggleStyle}" HorizontalAlignment="Right" Margin="0,0,15,0" IsChecked="{Binding RefreshAutoSwitch, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Background="#1C1C1F" CornerRadius="10" Height="70">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Path Data="M14,2L12.6,3.4C11.6,4.4 10.9,5.7 10.6,7.1L9.6,12L4.5,13.7C3.5,14 2.8,14.8 2.5,15.8L2.2,16.8L6.8,15.2C7.3,15 7.8,15 8.3,15.1L12.5,16.4C12.4,16.7 12.3,17 12.1,17.2L10.7,18.6L12.1,20L15.6,16.5C16.8,15.3 17.5,13.8 17.8,12.1L18.7,6.8L22,5.7C23,5.4 23.7,4.6 24,3.6L24.3,2.6L19.7,4.2C19.2,4.4 18.7,4.4 18.2,4.3L14,3C14.1,2.7 14.2,2.4 14.4,2.2L15.8,0.8L14,2Z" Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Run on Startup" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Launch NITROUS engine silently at boot." Foreground="#888890" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="TogStartup" Style="{StaticResource ModernToggleStyle}" HorizontalAlignment="Right" Margin="0,0,15,0" IsChecked="{Binding RunOnStartup, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Bottom Navigation -->
            <Border Grid.Row="2" Background="#1C1C1F" CornerRadius="0,0,15,15">
                <Grid>
                    <Grid.ColumnDefinitions>
