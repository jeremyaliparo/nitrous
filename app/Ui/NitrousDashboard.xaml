							</Grid>
							<!-- 2-Column Stats Grid -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="12"/>
									<!-- Spacer -->
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="12"/>
									<!-- Spacer -->
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="12"/>
									<!-- Spacer -->
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<!-- Row 0 -->
								<StackPanel Grid.Row="0" Grid.Column="0">
									<TextBlock Text="CORE LOAD" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
									<TextBlock Text="{Binding GpuLoadText}" Foreground="{Binding GpuLoadColor}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
								</StackPanel>
								<StackPanel Grid.Row="0" Grid.Column="1">
									<TextBlock Text="CORE TEMP" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
									<TextBlock Text="{Binding GpuDeepTempText}" Foreground="{Binding GpuDeepTempColor}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
								</StackPanel>
								<!-- Row 2 -->
								<StackPanel Grid.Row="2" Grid.Column="0">
									<TextBlock Text="CORE CLOCK" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
									<TextBlock Text="{Binding GpuCoreClockText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
								</StackPanel>
								<StackPanel Grid.Row="2" Grid.Column="1">
									<TextBlock Text="MEMORY CLOCK" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
									<TextBlock Text="{Binding GpuMemClockText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
								</StackPanel>
								<!-- Row 4 -->
								<StackPanel Grid.Row="4" Grid.Column="0">
									<TextBlock Text="VRAM USAGE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
									<TextBlock Text="{Binding GpuVramText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
								</StackPanel>
								<StackPanel Grid.Row="4" Grid.Column="1">
									<TextBlock Text="POWER / ENFORCED / CAP" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
									<TextBlock Text="{Binding GpuPowerText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
								</StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="0">
									<TextBlock Text="PERFORMANCE STATE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
									<TextBlock Text="{Binding GpuPStateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>
					<!-- CLOCK OFFSETS SLIDERS -->
					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="16,12,16,14" Margin="0,0,0,16">
						<StackPanel>
							<Grid Margin="0,0,0,8">
								<TextBlock Text="CLOCK OFFSETS" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
									<TextBlock Text="Manage GPU clocks" Foreground="{DynamicResource TextBodyBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Let Nitrous apply per-profile GPU core and memory offsets. When off, Nitrous never writes GPU clocks."/>
									<CheckBox x:Name="TogManageGpuClocks" Style="{StaticResource ModernToggleStyle}" IsChecked="{Binding ManageGpuClocks, UpdateSourceTrigger=PropertyChanged}" ToolTip="When off, Nitrous never writes GPU clocks or memory offsets."/>
								</StackPanel>
							</Grid>
							<TextBlock Text="{Binding GpuClockStatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
							<!-- Core Slider -->
							<Grid Margin="0,0,0,2">
								<TextBlock Text="Core Clock" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
									<TextBox x:Name="GpuCoreInput" Text="{Binding GpuCoreOffsetText, UpdateSourceTrigger=LostFocus}" LostFocus="GpuOffsetInput_LostFocus" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Background="Transparent" BorderThickness="0" MaxLength="4" Width="44" TextAlignment="Right" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" IsEnabled="{Binding ManageGpuClocks}"/>
									<TextBlock Text=" MHz" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<Slider x:Name="GpuCoreSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="300" Value="{Binding GpuCoreOffset, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="5" IsEnabled="{Binding ManageGpuClocks}"/>
							<Grid Margin="0,2,0,10">
								<TextBlock Text="0" Foreground="{DynamicResource TextDimBrush}" FontSize="9"/>
								<TextBlock Text="+300 MHz" Foreground="{DynamicResource TextDimBrush}" FontSize="9" HorizontalAlignment="Right"/>
							</Grid>
							<!-- Memory Slider -->
							<Grid Margin="0,0,0,2">
								<TextBlock Text="Memory Clock" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
									<TextBox x:Name="GpuMemoryInput" Text="{Binding GpuMemoryOffsetText, UpdateSourceTrigger=LostFocus}" LostFocus="GpuOffsetInput_LostFocus" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Background="Transparent" BorderThickness="0" MaxLength="5" Width="44" TextAlignment="Right" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" IsEnabled="{Binding ManageGpuClocks}"/>
									<TextBlock Text=" MHz" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<Slider x:Name="GpuMemorySlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="1000" Value="{Binding GpuMemoryOffset, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="10" IsEnabled="{Binding ManageGpuClocks}"/>
							<Grid Margin="0,2,0,10">
								<TextBlock Text="0" Foreground="{DynamicResource TextDimBrush}" FontSize="9"/>
								<TextBlock Text="+1000 MHz" Foreground="{DynamicResource TextDimBrush}" FontSize="9" HorizontalAlignment="Right"/>
							</Grid>
							<Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10"/>
							<!-- Compact action row: ghost RESET beside the accent APPLY -->
							<Grid>
								<TextBlock Text="{Binding ActivePowerProfile, StringFormat=Profile: {0}}" Foreground="{DynamicResource TextDimBrush}" FontSize="9.5" VerticalAlignment="Center"/>
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
									<Button Content="RESET" Command="{Binding ResetGpuClocksCommand}" Style="{StaticResource GhostBtn}" FontSize="10" FontWeight="Bold" Height="30" Padding="14,0" IsEnabled="{Binding ManageGpuClocks}" ToolTip="Save 0 / 0 MHz for this profile and return the GPU to stock clocks when it is awake."/>
									<Button Content="{Binding ApplyBtnText}" Command="{Binding ApplyGpuClocksCommand}" Background="{Binding ApplyBtnColor}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource AccentBtn}" FontSize="10" FontWeight="Bold" Height="30" MinWidth="88" Padding="18,0" Margin="8,0,0,0" IsEnabled="{Binding ManageGpuClocks}" ToolTip="Save and apply these offsets to the active profile."/>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
				</ScrollViewer>

				<!-- 4. LIGHTING PAGE -->
                <ScrollViewer x:Name="KeyboardPage" Visibility="Collapsed" Margin="20,10,20,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              BorderThickness="0" FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly">
                	<ScrollViewer.Resources>
                		<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBarStyle}"/>
                	</ScrollViewer.Resources>
                	<StackPanel Margin="0,0,4,16">
					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Margin="0,0,0,12" Padding="12">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,12,0">
								<Image Source="{StaticResource CachedAppLogo}" RenderOptions.BitmapScalingMode="HighQuality" Margin="8" Stretch="Uniform"/>
							</Border>
							<StackPanel VerticalAlignment="Center">
								<TextBlock x:Name="KeyboardVersionText" Text="Nitrous" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14"/>
								<TextBlock Text="Pure hardware control for Acer Nitro laptops." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- Lighting: Global and Area are two presets over the same two devices -->
					<Grid Margin="0,0,0,8">
						<TextBlock Text="LIGHTING" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock x:Name="KeyboardLightingStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
					</Grid>
					<Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,10">
						<UniformGrid Rows="1" Height="34">
							<RadioButton x:Name="LightingGlobalTab" Tag="M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,19.96C11.17,18.76 10.5,17.43 10.09,16H13.91C13.5,17.43 12.83,18.76 12,19.96M8,8H5.08C6.03,6.34 7.57,5.06 9.4,4.44C8.8,5.55 8.35,6.75 8,8M5.08,16H8C8.35,17.25 8.8,18.45 9.4,19.56C7.57,18.94 6.03,17.66 5.08,16M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14M12,4.03C12.83,5.23 13.5,6.57 13.91,8H10.09C10.5,6.57 11.17,5.23 12,4.03M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" TabIndex="0" GroupName="Lighting" Content="Global" IsChecked="True" Style="{StaticResource ActionButtonStyle}" Checked="LightingTab_Checked"/>
							<RadioButton x:Name="LightingAreaTab" Tag="M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M13,13H21V21H13V13Z" TabIndex="1" GroupName="Lighting" Content="Area" Style="{StaticResource ActionButtonStyle}" Checked="LightingTab_Checked"/>
						</UniformGrid>
					</Border>

					<!-- Global: one effect, written to the keyboard and then to the cover logo -->
					<Border x:Name="GlobalPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="15">
						<StackPanel>
							<TextBlock Text="One effect for the keyboard and the cover logo." Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,10" TextWrapping="Wrap"/>

							<Grid Margin="0,0,0,8">
								<TextBlock Text="Effect" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
								<ComboBox x:Name="GlobalEffectBox" Width="150" HorizontalAlignment="Right" ToolTip="The cover logo supports Static, Breathing and Neon only." Style="{StaticResource CompactComboBoxStyle}" SelectionChanged="GlobalEffect_Changed"/>
							</Grid>

							<Grid Margin="0,0,0,8">
								<TextBlock Text="Colour" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
								<Button x:Name="GlobalColorBtn" Width="110" Height="26" HorizontalAlignment="Right" Style="{StaticResource ColorChipStyle}" Click="GlobalColor_Click" Content="#B388FF" ToolTip="Keyboard and cover-logo colour"/>
							</Grid>

							<Grid Margin="0,0,0,2">
								<TextBlock Text="Brightness" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
								<TextBlock x:Name="GlobalBrightnessText" Text="100%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
							</Grid>
							<Slider x:Name="GlobalBrightness" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="GlobalBrightness_Changed"/>

							<StackPanel x:Name="GlobalSpeedRow" Margin="0,10,0,0">
								<Grid Margin="0,0,0,2">
									<TextBlock Text="Speed" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock x:Name="GlobalSpeedText" Text="3" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
								</Grid>
								<Slider x:Name="GlobalSpeed" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="GlobalSpeed_Changed"/>
							</StackPanel>

							<TextBlock Text="Switching tabs applies that preset. Colour applies to Static only." Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
						</StackPanel>
					</Border>

					<!-- Area: one card, with the device chosen at the top -->
					<StackPanel x:Name="AreaPanel" Visibility="Collapsed">
						<Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="15">
							<StackPanel>
								<Grid Margin="0,0,0,8">
									<TextBlock Text="DEVICE" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
								</Grid>
								<Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
									<UniformGrid Rows="1" Height="34">
										<RadioButton x:Name="AreaKeyboardTab" Tag="M19,10H17V8H19M19,13H17V11H19M16,10H14V8H16M16,13H14V11H16M13,10H11V8H13M13,13H11V11H13M8,10H6V8H8M8,13H6V11H8M5,10H3V8H5M5,13H3V11H5M4,17H20V15H4M22,5H2A2,2 0 0,0 0,7V17A2,2 0 0,0 2,19H22A2,2 0 0,0 24,17V7A2,2 0 0,0 22,5Z" TabIndex="0" GroupName="LightingArea" Content="Keyboard" IsChecked="True" Style="{StaticResource ActionButtonStyle}" Checked="AreaTab_Checked"/>
										<RadioButton x:Name="AreaLogoTab" Tag="M3,5H21V17H3V5M5,7V15H19V7H5M1,19H23V21H1V19Z" TabIndex="1" GroupName="LightingArea" Content="Cover logo" Style="{StaticResource ActionButtonStyle}" Checked="AreaTab_Checked"/>
									</UniformGrid>
								</Border>

								<Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,12,0,12"/>

								<StackPanel x:Name="AreaKeyboardPanel">
									<Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,12">
										<UniformGrid Rows="1" Height="34">
											<RadioButton x:Name="KbStaticTab" Tag="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2Z" TabIndex="0" GroupName="LightingMode" Content="Static" IsChecked="True" Style="{StaticResource ActionButtonStyle}" Checked="KbMode_Checked"/>
											<RadioButton x:Name="KbDynamicTab" Tag="M4,10H7V20H4V10M9,4H12V20H9V4M14,13H17V20H14V13M19,7H22V20H19V7Z" TabIndex="1" GroupName="LightingMode" Content="Dynamic" Style="{StaticResource ActionButtonStyle}" Checked="KbMode_Checked"/>
										</UniformGrid>
									</Border>

									<StackPanel x:Name="KbStaticPanel">
										<Grid x:Name="ZoneRow" Margin="0,0,0,10">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<Button x:Name="Zone1Btn" Grid.Column="0" Height="42" Margin="0,0,6,0" Tag="1" Click="Zone_Click" Content="Z1" ToolTip="Zone 1 colour" Style="{StaticResource ZoneSwatchStyle}"/>
											<Button x:Name="Zone2Btn" Grid.Column="1" Height="42" Margin="0,0,6,0" Tag="2" Click="Zone_Click" Content="Z2" ToolTip="Zone 2 colour" Style="{StaticResource ZoneSwatchStyle}"/>
											<Button x:Name="Zone3Btn" Grid.Column="2" Height="42" Margin="0,0,6,0" Tag="3" Click="Zone_Click" Content="Z3" ToolTip="Zone 3 colour" Style="{StaticResource ZoneSwatchStyle}"/>
											<Button x:Name="Zone4Btn" Grid.Column="3" Height="42" Margin="0,0,6,0" Tag="4" Click="Zone_Click" Content="Z4" ToolTip="Zone 4 colour" Style="{StaticResource ZoneSwatchStyle}"/>
											<Button x:Name="ZoneAllBtn" Grid.Column="4" Height="42" Tag="0" Click="Zone_Click" Content="ALL" ToolTip="Set all four zones to one colour." Style="{StaticResource ZoneSwatchStyle}"/>
										</Grid>
										<Grid x:Name="SingleColourRow" Visibility="Collapsed" Margin="0,0,0,10">
											<TextBlock Text="Colour" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
											<Button x:Name="KbSingleColorBtn" Width="110" Height="26" HorizontalAlignment="Right" Style="{StaticResource ColorChipStyle}" Click="KbColor_Click" Content="#B388FF" ToolTip="The keyboard's colour"/>
										</Grid>
										<TextBlock x:Name="ZoneHint" Text="This keyboard has a single colour, so one colour applies to the whole keyboard." Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"/>
										<TextBlock Text="Static has no speed: nothing animates, and the controller ignores the value." Foreground="{DynamicResource TextDimBrush}" FontSize="10" TextWrapping="Wrap"/>
									</StackPanel>

									<StackPanel x:Name="KbDynamicPanel" Visibility="Collapsed">
										<Grid Margin="0,0,0,8">
											<TextBlock Text="Effect" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
											<ComboBox x:Name="KeyboardEffectBox" Width="150" HorizontalAlignment="Right" Style="{StaticResource CompactComboBoxStyle}" SelectionChanged="KeyboardEffect_Changed"/>
										</Grid>

									</StackPanel>

									<Grid Margin="0,10,0,2">
										<TextBlock Text="Brightness" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
										<TextBlock x:Name="KeyboardBrightnessText" Text="100%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
									</Grid>
									<Slider x:Name="KeyboardBrightness" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="KeyboardBrightness_Changed"/>
										<StackPanel x:Name="KbSpeedRow" Margin="0,10,0,0">
											<Grid Margin="0,0,0,2">
												<TextBlock Text="Speed" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
												<TextBlock x:Name="KbSpeedText" Text="4" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
											</Grid>
											<Slider x:Name="KbSpeed" Minimum="1" Maximum="9" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="KbSpeed_Changed"/>
										</StackPanel>
								</StackPanel>

								<StackPanel x:Name="AreaLogoPanel" Visibility="Collapsed">
									<StackPanel x:Name="LogoControlsPanel">
									<Grid Margin="0,0,0,8">
										<TextBlock Text="Effect" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
										<ComboBox x:Name="LogoEffectBox" Width="150" HorizontalAlignment="Right" Style="{StaticResource CompactComboBoxStyle}" SelectionChanged="LogoEffect_Changed"/>
									</Grid>

									<Grid Margin="0,0,0,8">
										<TextBlock Text="Colour" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
										<Button x:Name="LogoColorBtn" Width="110" Height="26" HorizontalAlignment="Right" Style="{StaticResource ColorChipStyle}" Click="LogoColor_Click" Content="#B388FF" ToolTip="Cover-logo colour"/>
									</Grid>

									<Grid Margin="0,0,0,2">
										<TextBlock Text="Brightness" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
										<TextBlock x:Name="LogoBrightnessText" Text="100%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
									</Grid>
									<Slider x:Name="LogoBrightness" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="LogoBrightness_Changed"/>

									<StackPanel x:Name="LogoSpeedRow" Margin="0,10,0,0">
										<Grid Margin="0,0,0,2">
											<TextBlock Text="Speed" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
											<TextBlock x:Name="LogoSpeedText" Text="3" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
										</Grid>
										<Slider x:Name="LogoSpeed" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="LogoSpeed_Changed"/>
									</StackPanel>

									<TextBlock Text="Breathing and Neon cycle their own colours, so the colour picker is not used for them." Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
										<Button Content="TEST LID LOGO" Click="LogoCheck_Click" Style="{StaticResource GhostBtn}" FontSize="9" FontWeight="Bold" Padding="8,5" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0"/>
									</StackPanel>
									<StackPanel x:Name="LogoUnavailablePanel" Visibility="Collapsed">
										<TextBlock Text="No separate lid logo was detected on this model." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
										<TextBlock Text="On some models the 'N' only follows the power mode's colour and cannot be set independently. If it can change independently, run the check again." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
										<Button Content="CHECK AGAIN" Click="LogoCheck_Click" Style="{StaticResource GhostBtn}" FontSize="9" FontWeight="Bold" Padding="8,5" Height="26" HorizontalAlignment="Left" Margin="0,10,0,0"/>
									</StackPanel>
								</StackPanel>
							</StackPanel>
						</Border>
					</StackPanel>

					<!-- Sync: a software overlay that works on both presets; the target decides the lid -->
					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="15">
						<StackPanel>
							<Grid Margin="0,0,0,2">
								<TextBlock Text="SYNC" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
								<TextBlock Text="Software effect" Foreground="{DynamicResource TextDimBrush}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
							</Grid>
							<TextBlock Text="Follow the screen or the system audio. Runs while Nitrous is in the tray; the active preset's colours are its base. Turn it off to edit the effects." Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap"/>
							<Grid Margin="0,12,0,0">
								<StackPanel VerticalAlignment="Center" Margin="0,0,58,0">
									<TextBlock Text="Screen sync" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11"/>
									<TextBlock Text="Follows the screen's colours." Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
								</StackPanel>
								<CheckBox x:Name="TogScreenSync" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernToggleStyle}" Checked="ScreenSync_Toggled" Unchecked="ScreenSync_Toggled"/>
							</Grid>
							<StackPanel x:Name="ScreenSaturationRow" Margin="0,8,0,0" Visibility="Collapsed">
								<Grid Margin="0,0,0,2">
									<TextBlock Text="Screen saturation" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock x:Name="ScreenSaturationText" Text="100%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
								</Grid>
								<Slider x:Name="ScreenSaturation" Minimum="0" Maximum="200" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="ScreenSaturation_Changed"/>
							</StackPanel>
							<Grid Margin="0,8,0,0">
								<StackPanel VerticalAlignment="Center" Margin="0,0,58,0">
									<TextBlock Text="Sound sync" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11"/>
									<TextBlock Text="Pulses with the system audio." Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
								</StackPanel>
								<CheckBox x:Name="TogSoundSync" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernToggleStyle}" Checked="SoundSync_Toggled" Unchecked="SoundSync_Toggled"/>
							</Grid>
							<Grid x:Name="SoundModeRow" Margin="0,10,0,0" Visibility="Collapsed">
								<TextBlock Text="Sound mode" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
								<ComboBox x:Name="SoundModeBox" Width="130" HorizontalAlignment="Right" Style="{StaticResource CompactComboBoxStyle}" SelectionChanged="SoundMode_Changed"/>
							</Grid>
							<StackPanel x:Name="SoundSensitivityRow" Margin="0,8,0,0" Visibility="Collapsed">
								<Grid Margin="0,0,0,2">
									<TextBlock Text="Sound sensitivity" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock x:Name="SoundSensitivityText" Text="4" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
								</Grid>
								<Slider x:Name="SoundSensitivity" Minimum="1" Maximum="10" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ValueChanged="SoundSensitivity_Changed"/>
							</StackPanel>
							<Grid x:Name="SyncTargetRow" Margin="0,12,0,0" Visibility="Collapsed">
								<TextBlock Text="Follow" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
								<ComboBox x:Name="SyncTargetBox" Width="160" HorizontalAlignment="Right" Style="{StaticResource CompactComboBoxStyle}" SelectionChanged="SyncTarget_Changed"/>
							</Grid>
						</StackPanel>
					</Border>
					<!-- Power mode change flash: the OEM acknowledgement blink, reproduced standalone -->
					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="15">
						<Grid>
							<StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
								<TextBlock Text="Power mode change flash" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12"/>
								<TextBlock Text="Flashes the keyboard in the power mode's colour when the power mode changes." Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,2,58,0" TextWrapping="Wrap"/>
							</StackPanel>
							<CheckBox x:Name="TogBlinkOnMode" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernToggleStyle}" Checked="BlinkOnMode_Toggled" Unchecked="BlinkOnMode_Toggled"/>
						</Grid>
					</Border>
                	</StackPanel>
                </ScrollViewer>
			</Grid>
			<!-- Bottom Navigation -->
			<Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="0,0,15,15">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition x:Name="NavKeyboardColumn" Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<!-- Dash Nav -->
					<Button x:Name="NavDashBtn" Tag="0,0,0,15" Style="{StaticResource NavButtonStyle}" Grid.Column="0" Click="NavDashBtn_Click">
						<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
							<Path x:Name="NavDashIcon" Data="M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M13,13H21V21H13V13Z" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center"/>
							<TextBlock x:Name="NavDashText" Text="DASH" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
						</StackPanel>
					</Button>
					<!-- GPU Nav -->
					<Button x:Name="NavGpuBtn" Tag="0,0,0,0" Style="{StaticResource NavButtonStyle}" Grid.Column="1" Click="NavGpuBtn_Click">
						<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
							<Path x:Name="NavGpuIcon" Data="M22,9V7H20V5A2,2 0 0,0 18,3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H18A2,2 0 0,0 20,19V17H22V15H20V13H22V11H20V9H22M18,19H4V5H18V19" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center"/>
							<TextBlock x:Name="NavGpuText" Text="GPU" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button x:Name="NavKeyboardBtn" Tag="0,0,0,0" Style="{StaticResource NavButtonStyle}" Grid.Column="2" Click="NavKeyboardBtn_Click">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                            <Path x:Name="NavKeyboardIcon" Data="M19,10H17V8H19M19,13H17V11H19M16,10H14V8H16M16,13H14V11H16M13,10H11V8H13M13,13H11V11H13M8,10H6V8H8M8,13H6V11H8M5,10H3V8H5M5,13H3V11H5M4,17H20V15H4M22,5H2A2,2 0 0,0 0,7V17A2,2 0 0,0 2,19H22A2,2 0 0,0 24,17V7A2,2 0 0,0 22,5Z" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NavKeyboardText" Text="LIGHT" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
					<!-- Settings Nav -->
					<Button x:Name="NavSetBtn" Tag="0,0,15,0" Style="{StaticResource NavButtonStyle}" Grid.Column="3" Click="NavSetBtn_Click">
						<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
							<Path x:Name="NavSetIcon" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center"/>
							<TextBlock x:Name="NavSetText" Text="SETUP" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
						</StackPanel>
					</Button>
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>
