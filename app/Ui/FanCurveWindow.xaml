<Window x:Class="Nitrous.Ui.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Fan Curve" Height="660" Width="880"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource AppFontFamily}"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>

        <!-- Tooltip Drop Shadow -->
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="25" ShadowDepth="10" Opacity="0.6"/>

        <Style x:Key="TabPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="20,6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="14" Height="14" Background="{DynamicResource PanelDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,7 L6,10 L11,3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Margin="1" Visibility="Collapsed"/>
                            </Border>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SyncToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Icon" Data="M6,3H8A2,2 0 0,1 10,5V7A2,2 0 0,1 8,9H6 M4,7H2A2,2 0 0,1 0,5V3A2,2 0 0,1 2,1H4" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="12" Height="10" Margin="0,0,6,0"/>
                                <TextBlock Text="Sync" Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RampPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,4">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" Margin="20">
        <!-- Main Card -->
        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.2" Effect="{StaticResource CardShadow}">
            <Grid Margin="26,24,26,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Propeller Icon -->
                        <Grid Width="24" Height="24" Margin="0,0,12,0">
                            <Ellipse Stroke="{DynamicResource BorderSubtleBrush}" StrokeThickness="1.2"/>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"/>
                            <Path Data="M12 9a3 3 0 0 1 3-3c1.5 0 2 1.5 1 3l-3 1 M15 12a3 3 0 0 1 3 3c0 1.5-1.5 2-3 1l-1-3 M12 15a3 3 0 0 1-3 3c-1.5 0-2-1.5-1-3l3-1 M9 12a3 3 0 0 1-3-3c0-1.5 1.5-2 3-1l1 3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                        </Grid>
                        <TextBlock Text="Custom Fan Curve" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Tabs & Close Button -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{DynamicResource PanelDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabCpu" Content="CPU" IsChecked="True" Style="{StaticResource TabPillStyle}" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabGpu" Content="GPU" Style="{StaticResource TabPillStyle}" Checked="Tab_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- Fixed Close Button -->
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand" Click="CloseBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="16" FontWeight="Bold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- GRAPH AREA -->
                <Border Grid.Row="1" Background="{DynamicResource PanelDeepBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,25">
                    <Grid Margin="15,20,20,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <!-- Y-Axis Labels -->
                        <Grid Grid.Column="0" Grid.Row="0" Margin="0,-7,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="100%" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="75%" Foreground="{DynamicResource TextDimBrush}" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Text="50%" Foreground="{DynamicResource TextDimBrush}" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="3" Text="25%" Foreground="{DynamicResource TextDimBrush}" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                        <!-- 1% label at absolute bottom (0% is not a valid request) -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="1%" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,-7"/>

                        <!-- PLOT AREA -->
                        <Grid Grid.Column="1" Grid.Row="0">
                            <!-- Horizontal Grid Lines -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,1,0,0"/>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,1,0,0"/>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,1,0,0"/>
                                <Border Grid.Row="3" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,1,0,0"/>
                            </Grid>
                            <!-- Baseline 1% line -->
                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                            <!-- Vertical Grid Lines (30, 45, 60, 75, 90, 100) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="10*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1,0,0,0"/>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1,0,0,0"/>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1,0,0,0"/>
                                <Border Grid.Column="3" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1,0,0,0"/>
                                <Border Grid.Column="4" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1,0,1,0"/>
                            </Grid>

                            <!-- Canvas -->
                            <Canvas x:Name="GraphCanvas" ClipToBounds="False" MouseMove="GraphCanvas_MouseMove" MouseUp="GraphCanvas_MouseUp" MouseLeave="GraphCanvas_MouseLeave" Background="Transparent">
                                <Polyline x:Name="CurveLine" Stroke="{DynamicResource FanRampBrush}" StrokeThickness="3" StrokeLineJoin="Round" IsHitTestVisible="False"/>
                                <Border x:Name="NodeTooltip" Visibility="Hidden" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2" CornerRadius="6" Padding="10,4" Panel.ZIndex="999" IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TooltipText" Text="68°C · 43%" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- X-Axis Labels -->
                        <Grid Grid.Column="1" Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="10*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="30°C" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="45°C" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="60°C" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="75°C" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="90°C" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="100°C" Foreground="{DynamicResource HotBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,-15,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- OPTIONS DOCK -->
                <Grid Grid.Row="2" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox x:Name="TogEnableCurve" Content="Enable Curve Override" IsChecked="{Binding IsCurveModeEnabled}" Style="{StaticResource SimpleCheckBoxStyle}"/>
                        <CheckBox x:Name="TogSnapToGrid" Content="Snap to Grid (5% / 5°C)" IsChecked="True" Margin="25,0,0,0" Style="{StaticResource SimpleCheckBoxStyle}"/>
                    </StackPanel>

                    <!-- Ramp down belongs with the curve it shapes. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="RAMP DOWN" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="How quickly the fans may slow down after a load burst. Rises are always instant."/>
                        <RadioButton x:Name="RampOff" Content="Off" Tag="Off" Style="{StaticResource RampPillStyle}" Checked="Ramp_Checked"/>
                        <RadioButton x:Name="RampGentle" Content="Gentle" Tag="Gentle" Style="{StaticResource RampPillStyle}" Checked="Ramp_Checked"/>
                        <RadioButton x:Name="RampBalanced" Content="Balanced" Tag="Balanced" Style="{StaticResource RampPillStyle}" Checked="Ramp_Checked"/>
                        <RadioButton x:Name="RampFast" Content="Fast" Tag="Fast" Style="{StaticResource RampPillStyle}" Checked="Ramp_Checked"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <Grid>
                        <TextBlock Text="Tip: Drag any waypoint circle to adjust temperature thresholds." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Reset to Defaults" Click="ResetBtn_Click" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" Margin="0,0,15,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,6">
                                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="SAVE &amp; APPLY" Click="SaveBtn_Click" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Heavy" Height="36" Width="140" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6">
                                            <Grid>
                                                <!-- Subtle 15% white overlay for a premium hover effect -->
                                                <Border x:Name="HoverOverlay" Background="{DynamicResource TextPrimaryBrush}" Opacity="0" CornerRadius="6"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
