<Window x:Class="Nitrous.Ui.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        IsHitTestVisible="False"
        Width="220" Height="80" WindowStartupLocation="CenterScreen">

    <Border Background="#E61C1C1F" CornerRadius="12" BorderBrush="#a855f7" BorderThickness="2" Margin="10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- You can add an icon here -->
            <TextBlock x:Name="ProfileText" Text="PERFORMANCE" Foreground="White" FontWeight="Bold" FontSize="18" Margin="10,0,0,0"/>
        </StackPanel>
    </Border>
</Window>
