<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>Nitrous</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- The DPI mode lives in app.manifest because it must be active before the CLR loads,
		     which also covers the dashboard process. Application.SetHighDpiMode in Main is only a
		     fallback for hosts that ignore manifests. WFO0003 suggests the project property, but
		     that property is ignored when a custom manifest is supplied. -->
		<NoWarn>$(NoWarn);WFO0003</NoWarn>
		<ApplicationIcon>../assets/icon.ico</ApplicationIcon>
		<Version>0.8.4</Version>
		<Product>Nitrous</Product>
		<Company>Nitrous</Company>
		<RepositoryUrl>https://github.com/jeremyaliparo/nitrous</RepositoryUrl>
		<DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Management" Version="10.0.10" />
		<PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="..\assets\logo.png" Link="assets\logo.png" />
		<!-- The WinForms OSD loads the logo directly; using the WPF Resource would pull
		     PresentationFramework into the tray process. -->
		<EmbeddedResource Include="..\assets\logo.png" Link="assets\logo.png"
		                  LogicalName="Nitrous.assets.logo.png" />
	</ItemGroup>
</Project>
